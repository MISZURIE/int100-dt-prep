# Copy to .env.local and fill in.
# Local: values printed by `npx supabase start` (API URL + Publishable key).
# Hosted: Supabase dashboard > Project Settings > API Keys.
# Only the publishable key belongs here — never the secret / service_role key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
